# Local PostgreSQL or Railway's private reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Generate securely: openssl rand -base64 48. Keep stable across web replicas.
BETTER_AUTH_SECRET=
# Production must use the exact public HTTPS origin, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Disabled until the operator has approved Mistral contractual/privacy safeguards.
# Each organization's administrator must also enable processing in Settings.
AI_PROCESSING_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EXTRACTION_MODEL=mistral-large-latest
# Output budget per page range; lower this if selecting a model with a smaller limit.
MISTRAL_EXTRACTION_MAX_TOKENS=65536
MISTRAL_EXTRACTION_CONCURRENCY=4

# Map from the Railway bucket Credentials tab / variable references:
# S3_BUCKET=${{Documents.BUCKET}}
# S3_ENDPOINT=${{Documents.ENDPOINT}}
# S3_REGION=${{Documents.REGION}}
# S3_ACCESS_KEY_ID=${{Documents.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Documents.SECRET_ACCESS_KEY}}
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Current Railway buckets use virtual hosted URLs. Only legacy buckets may require true.
S3_FORCE_PATH_STYLE=false

# Optional future integrations; unused in Sprint 1.
OPENROUTER_API_KEY=

# Email verification. Set true with SMTP for public production signups.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Railway injects PORT. Local worker defaults to 3001.
WORKER_HEALTH_PORT=3001

# Optional tests only: use a disposable test database, never production.
TEST_DATABASE_URL=
# Paid Mistral tests require explicit opt-in and a local sample path.
RUN_MISTRAL_INTEGRATION=false
MISTRAL_INTEGRATION_FIXTURE=
