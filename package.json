{
  "name": "industrial-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test:mistral": "node --env-file-if-exists=.env --import tsx scripts/test-mistral.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@mistralai/mistralai": "3.1.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
